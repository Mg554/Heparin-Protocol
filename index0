<script>
'use strict';
// MERGED + SECURED: single source of truth for protocol values. Verify against hospital protocol.
const APP_VERSION = 'v2.0-merged-secure';
const LIMITS = { weightMin: 30, weightMax: 200, apttMin: 10, apttMax: 300, rateMin: 0, rateMax: 5000, protHeparinMin: 0, protHeparinMax: 50000 };
const protocols = {
  vte:  { bolusDose: 80, maxBolus: 5000, infRate: 18, targetLow: 60, targetHigh: 100, label: 'DVT/PE' },
  acs:  { bolusDose: 60, maxBolus: 4000, infRate: 12, targetLow: 50, targetHigh: 70, label: 'ACS/NSTEMI' },
  high: { bolusDose: 0,  maxBolus: 0,    infRate: 18, targetLow: 60, targetHigh: 100, label: 'High Risk' }
};
const nomograms = {
  vte: [
    { maxAptt: 39,  bolus: 80, maxBolus: 5000, rateChange: 3, hold: 0, label: 'Subtherapeutic - Critical Low' },
    { maxAptt: 49,  bolus: 40, maxBolus: 3000, rateChange: 2, hold: 0, label: 'Subtherapeutic - Low' },
    { maxAptt: 59,  bolus: 0,  maxBolus: 0,    rateChange: 1, hold: 0, label: 'Subtherapeutic - Borderline' },
    { maxAptt: 100, bolus: 0,  maxBolus: 0,    rateChange: 0,  hold: 0, label: 'THERAPEUTIC' },
    { maxAptt: 120, bolus: 0,  maxBolus: 0,    rateChange: -1, hold: 0, label: 'Supratherapeutic - Mild' },
    { maxAptt: 150, bolus: 0,  maxBolus: 0,    rateChange: -2, hold: 30, label: 'Supratherapeutic - Moderate' },
    { maxAptt: 9999,bolus: 0,  maxBolus: 0,    rateChange: -3, hold: 60, label: 'Supratherapeutic - CRITICAL' }
  ],
  acs: [
    { maxAptt: 39,  bolus: 60, maxBolus: 4000, rateChange: 2, hold: 0, label: 'Subtherapeutic - Critical Low' },
    { maxAptt: 49,  bolus: 0,  maxBolus: 0,    rateChange: 1, hold: 0, label: 'Subtherapeutic - Low' },
    { maxAptt: 70,  bolus: 0,  maxBolus: 0,    rateChange: 0,  hold: 0, label: 'THERAPEUTIC' },
    { maxAptt: 90,  bolus: 0,  maxBolus: 0,    rateChange: -1, hold: 0, label: 'Supratherapeutic - Mild' },
    { maxAptt: 120, bolus: 0,  maxBolus: 0,    rateChange: -2, hold: 30, label: 'Supratherapeutic - Moderate' },
    { maxAptt: 9999,bolus: 0,  maxBolus: 0,    rateChange: -3, hold: 60, label: 'Supratherapeutic - CRITICAL' }
  ]
};
let currentProto = 'vte';
let currentConc = 50;
let titCurrentConc = 50;
let titProto = 'vte';

function setText(id, value){ const el=document.getElementById(id); if(el) el.textContent=value; }
function showError(id, msg){ const el=document.getElementById(id); if(!el) return; if(msg){ el.textContent=msg; el.classList.add('show'); } else { el.textContent=''; el.classList.remove('show'); } }
function markInvalid(input, isInvalid){ if(input) input.classList.toggle('invalid', !!isInvalid); }
function parseStrict(value, min, max){
  if(value===null || value===undefined) return { ok:false };
  const trimmed=String(value).trim();
  if(trimmed==='') return { ok:false };
  const n=Number(trimmed);
  if(!Number.isFinite(n)) return { ok:false };
  if(n<min || n>max) return { ok:false, outOfRange:true, value:n };
  return { ok:true, value:n };
}
function round10(n){ return Math.round(n/10)*10; }
function formatNum(n){ return Number(n).toLocaleString('en-US'); }

function switchTab(name, btn){
  document.querySelectorAll('.content').forEach(c=>c.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t=>{ t.classList.remove('active'); t.setAttribute('aria-selected','false'); });
  const panel=document.getElementById('tab-'+name); if(panel) panel.classList.add('active');
  if(btn){ btn.classList.add('active'); btn.setAttribute('aria-selected','true'); }
}
function clearInitResults(){ const el=document.getElementById('init-results'); if(el) el.style.display='none'; }

function calcInitial(){
  const input=document.getElementById('weight');
  const parsed=parseStrict(input.value, LIMITS.weightMin, LIMITS.weightMax);
  const confirmBox=document.getElementById('init-confirm');
  if(!parsed.ok){ markInvalid(input,true); showError('init-error', parsed.outOfRange ? 'الوزن لازم يكون بين 30 و 200 كغ. راجع الرقم قبل الحساب.' : 'أدخل وزن صحيح بين 30 و 200 كغ.'); return; }
  if(!confirmBox || !confirmBox.checked){ showError('init-error','فعّل مربع المراجعة بعد ما تتأكد من الوزن والبروتوكول والتركيز.'); return; }
  markInvalid(input,false); showError('init-error','');
  const wt=parsed.value;
  const proto=protocols[currentProto];
  let bolusUnits=0; let bolusNote='';
  if(proto.bolusDose>0){
    const rawBolus=proto.bolusDose*wt;
    bolusUnits=Math.min(rawBolus, proto.maxBolus);
    if(rawBolus>proto.maxBolus){ bolusNote='تنبيه: الجرعة المحسوبة تجاوزت الحد الأقصى، تم تطبيق الحد الأقصى. راجع بروتوكول المستشفى.'; } else { bolusNote='الجرعة الكاملة بحسب الوزن.'; }
  } else { bolusNote='بروتوكول High Risk، بدون Bolus.'; }
  const rateUhr=round10(proto.infRate*wt);
  const rateML=(rateUhr/currentConc).toFixed(1);
  const bolusML=(bolusUnits/currentConc).toFixed(1);
  setText('res-bolus', bolusUnits>0 ? formatNum(bolusUnits)+' units' : 'لا يوجد');
  setText('res-bolus-ml', bolusUnits>0 ? '= '+bolusML+' mL IV over 3 to 5 min' : 'High Risk Protocol');
  setText('res-rate-uhr', formatNum(rateUhr));
  setText('res-rate-ml', rateML);
  setText('res-rate-kghr', proto.infRate+' u/kg/hr');
  setText('res-target-range', 'Target aPTT: '+proto.targetLow+' to '+proto.targetHigh+' sec ('+proto.label+')');
  setText('bolus-note', bolusNote);
  const res=document.getElementById('init-results'); res.style.display='block';
  res.scrollIntoView({behavior:'smooth', block:'nearest'});
}
function showZoneHint(){
  const apttInput=document.getElementById('aptt-val');
  const parsed=parseStrict(apttInput.value, LIMITS.apttMin, LIMITS.apttMax);
  const hint=document.getElementById('zone-hint');
  if(!parsed.ok){ hint.style.display='none'; return; }
  const zone=nomograms[titProto].find(z=>parsed.value<=z.maxAptt);
  if(!zone){ hint.style.display='none'; return; }
  let cls='alert alert-yellow';
  if(zone.rateChange===0) cls='alert alert-green';
  else if(zone.rateChange>1 || zone.hold>0) cls='alert alert-red';
  hint.className=cls;
  hint.textContent=zone.label;
  hint.style.display='block';
}
function calcTitration(){
  const wtInput=document.getElementById('tit-weight');
  const apttInput=document.getElementById('aptt-val');
  const rateInput=document.getElementById('current-rate');
  const confirmBox=document.getElementById('tit-confirm');
  const wtP=parseStrict(wtInput.value, LIMITS.weightMin, LIMITS.weightMax);
  const apttP=parseStrict(apttInput.value, LIMITS.apttMin, LIMITS.apttMax);
  const rateP=parseStrict(rateInput.value, LIMITS.rateMin, LIMITS.rateMax);
  markInvalid(wtInput, !wtP.ok); markInvalid(apttInput, !apttP.ok); markInvalid(rateInput, !rateP.ok);
  if(!wtP.ok || !apttP.ok || !rateP.ok){ showError('tit-error','أدخل كل البيانات بشكل صحيح: الوزن بين 30 و 200، نتيجة الفحص بين 10 و 300، المعدل الحالي بين 0 و 5000.'); return; }
  if(!confirmBox || !confirmBox.checked){ showError('tit-error','فعّل مربع المراجعة بعد ما تتأكد من كل المدخلات.'); return; }
  showError('tit-error','');
  const wt=wtP.value, aptt=apttP.value, currRate=rateP.value;
  const zone=nomograms[titProto].find(z=>aptt<=z.maxAptt); if(!zone) return;
  let bolusUnits=0;
  let bolusLine='';
  if(zone.bolus>0){ bolusUnits=Math.min(zone.bolus*wt, zone.maxBolus); bolusLine='أعط Bolus: '+formatNum(bolusUnits)+' units IV ('+(bolusUnits/titCurrentConc).toFixed(1)+' mL)'; }
  const rateChange=zone.rateChange*wt;
  let newRateUhr=round10(currRate+rateChange);
  let clamped=false;
  if(newRateUhr<0){ newRateUhr=0; clamped=true; }
  const newRateML=(newRateUhr/titCurrentConc).toFixed(1);
  const nextCheck=zone.rateChange===0 ? 'بعد 6 ساعات (ثم 12h إذا ثاني نتيجة therapeutic)' : 'بعد 6 ساعات';
  const actionEl=document.getElementById('tit-action');
  actionEl.textContent='';
  function addLine(text, cls){
    const div=document.createElement('div'); div.textContent=text; if(cls) div.className=cls; actionEl.appendChild(div);
  }
  if(zone.hold>0) addLine('أوقف الـ infusion لمدة '+zone.hold+' دقيقة، ثم ابدأ بالمعدل الجديد', 'action-stop');
  if(bolusLine) addLine(bolusLine, 'action-increase');
  if(zone.rateChange===0){ addLine('لا تغيير في المعدل، '+zone.label, 'action-hold'); }
  else { addLine((zone.rateChange>0 ? 'زيادة بمقدار ' : 'تخفيض بمقدار ')+Math.abs(zone.rateChange)+' u/kg/h', zone.rateChange>0 ? 'action-increase' : 'action-decrease'); addLine('المعدل الجديد: '+formatNum(newRateUhr)+' units/hr ('+newRateML+' mL/hr)', 'action-hold'); }
  if(clamped) addLine('تنبيه: المعدل الجديد كان سالبا وتم تثبيته على صفر. راجع الطبيب فورا.', 'action-stop');
  setText('tit-new-rate', formatNum(newRateUhr));
  setText('tit-ml-rate', newRateML);
  setText('tit-next-check', nextCheck);
  const bolusCard=document.getElementById('tit-bolus-card');
  if(bolusUnits>0){ setText('tit-bolus-val', formatNum(bolusUnits)); bolusCard.style.display='block'; } else { bolusCard.style.display='none'; }
  const result=document.getElementById('titration-result');
  result.style.borderColor=zone.rateChange===0 ? 'var(--green)' : zone.hold>0 ? 'var(--red)' : 'var(--orange)';
  result.classList.add('show');
  result.scrollIntoView({behavior:'smooth', block:'nearest'});
}
function calcProtamine(){
  const input=document.getElementById('prot-hep');
  const parsed=parseStrict(input.value, LIMITS.protHeparinMin, LIMITS.protHeparinMax);
  if(!parsed.ok){ markInvalid(input,true); showError('prot-error','أدخل كمية هيبارين صحيحة بين 0 و 50000 وحدة.'); return; }
  markInvalid(input,false); showError('prot-error','');
  let dose=parsed.value/100;
  let capped=false;
  if(dose>50){ dose=50; capped=true; }
  setText('prot-dose', dose.toFixed(1));
  setText('prot-warn', capped ? 'تنبيه: تم تطبيق الحد الأقصى 50mg. راجع بروتوكول المستشفى.' : '');
  document.getElementById('prot-result').style.display='block';
}
function updateInitReview(){
  const p=parseStrict(document.getElementById('weight').value, LIMITS.weightMin, LIMITS.weightMax);
  const box=document.getElementById('init-review');
  if(!p.ok){ box.classList.remove('show'); return; }
  box.textContent='مراجعة: الوزن '+p.value+' كغ، البروتوكول '+protocols[currentProto].label+'، التركيز '+currentConc+' units/mL.';
  box.classList.add('show');
}
function updateTitReview(){
  const w=parseStrict(document.getElementById('tit-weight').value, LIMITS.weightMin, LIMITS.weightMax);
  const a=parseStrict(document.getElementById('aptt-val').value, LIMITS.apttMin, LIMITS.apttMax);
  const r=parseStrict(document.getElementById('current-rate').value, LIMITS.rateMin, LIMITS.rateMax);
  const box=document.getElementById('tit-review');
  if(!w.ok && !a.ok && !r.ok){ box.classList.remove('show'); return; }
  box.textContent='مراجعة: الوزن '+(w.ok?w.value:'؟')+'، الفحص '+(a.ok?a.value:'؟')+'، المعدل '+(r.ok?r.value:'؟')+'، التركيز '+titCurrentConc+'.';
  box.classList.add('show');
}

document.addEventListener('DOMContentLoaded', ()=>{
  document.querySelectorAll('[data-tab]').forEach(btn=>btn.addEventListener('click', ()=>switchTab(btn.dataset.tab, btn)));
  document.querySelectorAll('#proto-group [data-proto]').forEach(btn=>btn.addEventListener('click', ()=>{
    currentProto=btn.dataset.proto;
    document.querySelectorAll('#proto-group .proto-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active'); clearInitResults();
  }));
  document.querySelectorAll('#tit-proto-group [data-titproto]').forEach(btn=>btn.addEventListener('click', ()=>{
    titProto=btn.dataset.titproto;
    document.querySelectorAll('#tit-proto-group .proto-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('titration-result').classList.remove('show');
  }));
  document.querySelectorAll('#conc-group [data-conc]').forEach(b=>{
    function pick(){ currentConc=Number(b.dataset.conc); document.querySelectorAll('#conc-group .conc-badge').forEach(c=>{c.classList.remove('selected'); c.setAttribute('aria-pressed','false');}); b.classList.add('selected'); b.setAttribute('aria-pressed','true'); updateInitReview(); }
    b.addEventListener('click', pick); b.addEventListener('keydown', e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); pick(); }});
  });
  document.querySelectorAll('#tit-conc-group [data-tconc]').forEach(b=>{
    function pick(){ titCurrentConc=Number(b.dataset.tconc); document.querySelectorAll('#tit-conc-group .conc-badge').forEach(c=>{c.classList.remove('selected'); c.setAttribute('aria-pressed','false');}); b.classList.add('selected'); b.setAttribute('aria-pressed','true'); updateTitReview(); }
    b.addEventListener('click', pick); b.addEventListener('keydown', e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); pick(); }});
  });
  const weightInput=document.getElementById('weight'); weightInput.addEventListener('input', ()=>{ clearInitResults(); updateInitReview(); });
  document.getElementById('btn-calc-initial').addEventListener('click', calcInitial);
  document.getElementById('aptt-val').addEventListener('input', ()=>{ showZoneHint(); updateTitReview(); });
  document.getElementById('tit-weight').addEventListener('input', updateTitReview);
  document.getElementById('current-rate').addEventListener('input', updateTitReview);
  document.getElementById('btn-calc-titration').addEventListener('click', calcTitration);
  document.getElementById('btn-calc-protamine').addEventListener('click', calcProtamine);
  if('serviceWorker' in navigator){
    window.addEventListener('load', ()=>{
      navigator.serviceWorker.register('./sw.js').then(reg=>console.log('SW registered:', reg.scope)).catch(err=>console.log('SW failed:', err));
    });
  }
});
