<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><style>
@font-face {
  font-family: "Optimistic";
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: url("/fonts/OptimisticAI_VF_Optimized.woff2") format("woff2");
}
@font-face {
  font-family: "Optimistic Mono";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("/fonts/OptimisticMono_W_TextRegular.woff2") format("woff2");
}
:where(html) {
  font-family: "Optimistic", system-ui, sans-serif;
}
:where(code, pre, kbd, samp) {
  font-family: "Optimistic Mono", ui-monospace, monospace;
}
</style>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Heparin Infusion Protocol - Merged Secure v2.0</title>
<link rel="manifest" href="./manifest.json">
<meta name="theme-color" content="#e63946">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Heparin">
<link rel="apple-touch-icon" href="./icon-192.png">
<!-- SECURITY: No external fonts. System fonts only, works offline, no third-party tracking. -->
<!-- PROTOCOL VERSION: v2.0-merged-secure. Source: index.html kept as base, index-updated.html was empty (1 blank line). Verify all protocol values against your hospital protocol before clinical use. -->
<style>
  :root{--red:#e63946;--orange:#f4a261;--green:#2a9d8f;--blue:#1d3557;--light:#f1faee;--yellow:#ffd166;--dark:#0d1b2a;--card:#132133;--border:#1e3a5f;--text:#e8f4fd;--muted:#7ba7c8}
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--dark);color:var(--text);font-family:system-ui,-apple-system,'Segoe UI',Tahoma,Arial,sans-serif;min-height:100vh;overflow-x:hidden}
  header{background:linear-gradient(135deg,#0d1b2a 0%,#132133 100%);border-bottom:2px solid var(--red);padding:16px 16px 12px;position:sticky;top:0;z-index:100}
  .header-top{display:flex;align-items:center;gap:10px}
  .logo{width:40px;height:40px;background:var(--red);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
  h1{font-family:ui-monospace,Menlo,monospace;font-size:15px;font-weight:700;letter-spacing:1px;color:var(--light)}
  .subtitle{font-size:11px;color:var(--muted);font-family:ui-monospace,Menlo,monospace;margin-top:2px}
  .warning-bar{background:rgba(230,57,70,.15);border:1px solid rgba(230,57,70,.4);border-radius:6px;padding:6px 10px;margin-top:10px;font-size:11px;color:#ff9999;text-align:center}
  .version-bar{background:rgba(255,209,102,.1);border:1px solid rgba(255,209,102,.4);border-radius:6px;padding:6px 10px;margin-top:8px;font-size:11px;color:var(--yellow);text-align:center}
  .tabs{display:flex;background:var(--card);border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none}
  .tabs::-webkit-scrollbar{display:none}
  .tab{flex:1;min-width:70px;padding:12px 8px;background:none;border:none;color:var(--muted);font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap;text-align:center}
  .tab.active{color:var(--red);border-bottom-color:var(--red);background:rgba(230,57,70,.08)}
  .content{padding:16px;display:none}
  .content.active{display:block}
  .section-title{font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:12px;margin-top:20px;display:flex;align-items:center;gap:8px}
  .section-title:first-child{margin-top:0}
  .section-title::before{content:'';display:block;width:20px;height:2px;background:var(--red)}
  .card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:12px}
  .card-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;font-family:ui-monospace,Menlo,monospace;margin-bottom:6px}
  .card-value{font-family:ui-monospace,Menlo,monospace;font-size:22px;font-weight:700;color:var(--yellow)}
  .input-group{margin-bottom:14px}
  label{display:block;font-size:13px;color:var(--muted);margin-bottom:6px;font-weight:700}
  input[type="number"],select{width:100%;background:var(--dark);border:1.5px solid var(--border);border-radius:8px;padding:12px 14px;color:var(--text);font-size:16px;font-family:ui-monospace,Menlo,monospace}
  input[type="number"]:focus,select:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px rgba(230,57,70,.15)}
  input.invalid{border-color:var(--red);box-shadow:0 0 0 3px rgba(230,57,70,.2)}
  select option{background:var(--dark)}
  .btn{width:100%;padding:14px;background:var(--red);border:none;border-radius:10px;color:white;font-size:16px;font-weight:900;font-family:inherit;cursor:pointer;letter-spacing:.5px;margin-top:6px}
  .btn:active{transform:scale(.98);background:#c1121f}
  .btn:disabled{opacity:.55;cursor:not-allowed}
  .btn-secondary{background:transparent;border:1.5px solid var(--border);color:var(--muted)}
  .result-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
  .result-item{background:var(--dark);border:1px solid var(--border);border-radius:8px;padding:12px}
  .result-item.highlight{border-color:var(--yellow);background:rgba(255,209,102,.08)}
  .result-item.full{grid-column:1/-1}
  .result-label{font-size:10px;color:var(--muted);font-family:ui-monospace,Menlo,monospace;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
  .result-val{font-family:ui-monospace,Menlo,monospace;font-size:20px;font-weight:700;color:var(--yellow)}
  .result-sub{font-size:10px;color:var(--muted);font-family:ui-monospace,Menlo,monospace;margin-top:2px}
  .titration-result{background:var(--card);border:2px solid var(--green);border-radius:12px;padding:16px;margin-top:16px;display:none}
  .titration-result.show{display:block}
  .titration-action{font-size:14px;font-weight:700;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--border);line-height:1.5}
  .action-stop{color:var(--red)}.action-increase{color:var(--orange)}.action-decrease{color:var(--yellow)}.action-hold{color:var(--green)}
  .ref-table{width:100%;border-collapse:collapse;font-size:12px;font-family:ui-monospace,Menlo,monospace;margin-top:6px}
  .ref-table th{background:rgba(29,53,87,.8);padding:8px 6px;text-align:center;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.5px;border-bottom:2px solid var(--border)}
  .ref-table td{padding:9px 6px;text-align:center;border-bottom:1px solid rgba(30,58,95,.5);color:var(--text);font-size:11px}
  .ref-table tr.therapeutic td{background:rgba(42,157,143,.1)}
  .badge{display:inline-block;padding:2px 6px;border-radius:4px;font-size:9px;font-weight:700;text-transform:uppercase}
  .badge-hold{background:var(--green);color:#fff}.badge-stop{background:var(--red);color:#fff}.badge-up{background:var(--orange);color:#000}.badge-dn{background:var(--yellow);color:#000}
  .step{display:flex;gap:12px;margin-bottom:14px;align-items:flex-start}
  .step-num{width:28px;height:28px;background:var(--red);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:13px;flex-shrink:0;font-family:ui-monospace,Menlo,monospace}
  .step-content{flex:1;padding-top:3px}.step-title{font-weight:700;font-size:14px;margin-bottom:4px}.step-desc{font-size:12px;color:var(--muted);line-height:1.6}
  .step-desc code{font-family:ui-monospace,Menlo,monospace;background:rgba(255,255,255,.08);padding:1px 5px;border-radius:3px;color:var(--yellow);font-size:11px}
  hr{border:none;border-top:1px solid var(--border);margin:16px 0}
  .conc-row{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap}
  .conc-badge{flex:1;min-width:100px;background:var(--dark);border:1px solid var(--border);border-radius:8px;padding:10px;text-align:center;cursor:pointer;border-top:3px solid transparent}
  .conc-badge.selected{border-top-color:var(--red);background:rgba(230,57,70,.1)}
  .conc-badge .val{font-family:ui-monospace,Menlo,monospace;font-size:14px;font-weight:700;color:var(--yellow)}
  .conc-badge .lbl{font-size:10px;color:var(--muted);margin-top:2px}
  .alert{border-radius:8px;padding:10px 14px;font-size:12px;line-height:1.6;margin-bottom:10px}
  .alert-red{background:rgba(230,57,70,.12);border-left:3px solid var(--red);color:#ffaaaa}
  .alert-green{background:rgba(42,157,143,.12);border-left:3px solid var(--green);color:#99ddd6}
  .alert-yellow{background:rgba(255,209,102,.1);border-left:3px solid var(--yellow);color:#ffd166}
  .proto-select{display:flex;gap:8px;margin-bottom:12px}
  .proto-btn{flex:1;padding:10px 6px;background:var(--dark);border:1.5px solid var(--border);border-radius:8px;color:var(--muted);font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;text-align:center}
  .proto-btn.active{background:rgba(230,57,70,.15);border-color:var(--red);color:var(--red)}
  .timeline{position:relative;padding-right:20px}
  .timeline::before{content:'';position:absolute;right:9px;top:6px;bottom:6px;width:2px;background:var(--border)}
  .tl-item{position:relative;margin-bottom:16px;padding-right:26px}
  .tl-item::before{content:'';position:absolute;right:3px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--red);border:2px solid var(--dark);z-index:1}
  .tl-item.done::before{background:var(--green)}
  .tl-time{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:var(--red);font-weight:700}
  .tl-text{font-size:13px;margin-top:2px;line-height:1.5}.tl-sub{font-size:11px;color:var(--muted);margin-top:2px;font-family:ui-monospace,Menlo,monospace}
  .scroll-hint{text-align:center;font-size:10px;color:rgba(123,167,200,.4);padding:8px;font-family:ui-monospace,Menlo,monospace}
  .error-box{display:none;background:rgba(230,57,70,.15);border:1px solid var(--red);border-radius:8px;padding:10px 12px;font-size:13px;line-height:1.6;margin-bottom:12px;color:#ffcccc}
  .error-box.show{display:block}
  .review-box{display:none;background:rgba(42,157,143,.1);border:1px solid var(--green);border-radius:8px;padding:12px;font-size:13px;line-height:1.6;margin-bottom:12px}
  .review-box.show{display:block}
  .confirm-row{display:flex;gap:8px;align-items:flex-start;margin:10px 0;font-size:13px;line-height:1.5}
  .confirm-row input{width:20px;height:20px;flex-shrink:0;margin-top:2px}
</style>
</head>
<body>
<header>
  <div class="header-top"><div class="logo" aria-hidden="true">💉</div><div><h1>HEPARIN DRIP PROTOCOL</h1><div class="subtitle">Weight-Based IV UFH Nomogram (Raschke)</div></div></div>
  <div class="warning-bar">⚠️ للاستخدام المرجعي فقط، دائما راجع بروتوكول مستشفاك</div>
  <div class="version-bar">نسخة مدمجة ومؤمنة v2.0، الملف الثاني كان فارغا وتم حذفه من الدمج، راجع القيم الطبية مع الصيدلي قبل الاستخدام</div>
</header>
<nav class="tabs" role="tablist" aria-label="أقسام التطبيق">
  <button class="tab active" data-tab="init" role="tab" aria-selected="true">🚀 البدء</button>
  <button class="tab" data-tab="titrate" role="tab" aria-selected="false">📊 Titration</button>
  <button class="tab" data-tab="nomogram" role="tab" aria-selected="false">📋 Nomogram</button>
  <button class="tab" data-tab="monitor" role="tab" aria-selected="false">⏱️ متابعة</button>
</nav>

<!-- TAB 1 -->
<div id="tab-init" class="content active">
  <div class="section-title">اختر البروتوكول</div>
  <div class="proto-select" id="proto-group">
    <button class="proto-btn active" data-proto="vte">DVT/PE<br><small style="font-size:9px">aPTT 60 to 100s</small></button>
    <button class="proto-btn" data-proto="acs">ACS/NSTEMI<br><small style="font-size:9px">aPTT 50 to 70s</small></button>
    <button class="proto-btn" data-proto="high">High Risk<br><small style="font-size:9px">No Bolus</small></button>
  </div>
  <div class="section-title">بيانات المريض</div>
  <div id="init-error" class="error-box" role="alert" aria-live="polite"></div>
  <div class="input-group"><label for="weight">الوزن (kg)</label><input type="number" id="weight" placeholder="مثال: 70" min="30" max="200" step="0.5" inputmode="decimal" autocomplete="off"></div>
  <div class="section-title">تركيز المحلول</div>
  <div class="conc-row" id="conc-group">
    <div class="conc-badge selected" data-conc="50" data-id="conc1" role="button" tabindex="0" aria-pressed="true"><div class="val">50</div><div class="lbl">units/mL</div><div class="lbl">25K/500mL</div></div>
    <div class="conc-badge" data-conc="100" data-id="conc2" role="button" tabindex="0" aria-pressed="false"><div class="val">100</div><div class="lbl">units/mL</div><div class="lbl">25K/250mL</div></div>
    <div class="conc-badge" data-conc="40" data-id="conc3" role="button" tabindex="0" aria-pressed="false"><div class="val">40</div><div class="lbl">units/mL</div><div class="lbl">20K/500mL</div></div>
  </div>
  <div id="init-review" class="review-box" aria-live="polite"></div>
  <label class="confirm-row"><input type="checkbox" id="init-confirm"><span>راجعت الوزن والبروتوكول والتركيز، وأعرف أن النتيجة لازم تتراجع مع بروتوكول المستشفى.</span></label>
  <button class="btn" id="btn-calc-initial" type="button">احسب الجرعة الأولية</button>
  <div id="init-results" style="display:none; margin-top:16px;">
    <div class="section-title">النتيجة</div>
    <div class="result-grid">
      <div class="result-item highlight full"><div class="result-label">Bolus Dose</div><div class="result-val" id="res-bolus">—</div><div class="result-sub" id="res-bolus-ml">—</div></div>
      <div class="result-item"><div class="result-label">Initial Rate</div><div class="result-val" id="res-rate-uhr">—</div><div class="result-sub">units/hr</div></div>
      <div class="result-item"><div class="result-label">Pump Rate</div><div class="result-val" id="res-rate-ml">—</div><div class="result-sub">mL/hr</div></div>
      <div class="result-item full"><div class="result-label">units/kg/hr</div><div class="result-val" id="res-rate-kghr">—</div><div class="result-sub" id="res-target-range">—</div></div>
    </div>
    <div class="alert alert-yellow" id="bolus-note"></div>
    <div class="alert alert-green">✅ اسحب aPTT بعد <strong>6 ساعات</strong> من البدء</div>
  </div>
</div>

<!-- TAB 2 -->
<div id="tab-titrate" class="content">
  <div class="section-title">بيانات للتعديل</div>
  <div class="proto-select" id="tit-proto-group">
    <button class="proto-btn active" data-titproto="vte">DVT/PE<br><small style="font-size:9px">60 to 100s</small></button>
    <button class="proto-btn" data-titproto="acs">ACS<br><small style="font-size:9px">50 to 70s</small></button>
  </div>
  <div id="tit-error" class="error-box" role="alert" aria-live="polite"></div>
  <div class="input-group"><label for="tit-weight">وزن المريض (kg)</label><input type="number" id="tit-weight" placeholder="مثال: 70" min="30" max="200" inputmode="decimal" autocomplete="off"></div>
  <div class="input-group"><label for="aptt-val">الـ aPTT الحالي (ثانية)</label><input type="number" id="aptt-val" placeholder="مثال: 45" min="10" max="300" inputmode="decimal" autocomplete="off"></div>
  <div id="zone-hint" style="display:none; margin-bottom:10px;"></div>
  <div class="input-group"><label for="current-rate">معدل الـ Infusion الحالي (units/hr)</label><input type="number" id="current-rate" placeholder="مثال: 1260" min="0" max="5000" inputmode="decimal" autocomplete="off"></div>
  <div class="section-title">تركيز المحلول</div>
  <div class="conc-row" id="tit-conc-group">
    <div class="conc-badge selected" data-tconc="50" role="button" tabindex="0" aria-pressed="true"><div class="val">50</div><div class="lbl">units/mL</div></div>
    <div class="conc-badge" data-tconc="100" role="button" tabindex="0" aria-pressed="false"><div class="val">100</div><div class="lbl">units/mL</div></div>
    <div class="conc-badge" data-tconc="40" role="button" tabindex="0" aria-pressed="false"><div class="val">40</div><div class="lbl">units/mL</div></div>
  </div>
  <div id="tit-review" class="review-box" aria-live="polite"></div>
  <label class="confirm-row"><input type="checkbox" id="tit-confirm"><span>راجعت الوزن ونتيجة الفحص والمعدل الحالي والتركيز.</span></label>
  <button class="btn" id="btn-calc-titration" type="button">احسب التعديل</button>
  <div id="titration-result" class="titration-result">
    <div class="result-label" style="margin-bottom:8px">📋 ORDER</div>
    <div id="tit-action" class="titration-action"></div>
    <div class="result-grid" style="margin-top:0">
      <div class="result-item" id="tit-bolus-card" style="display:none"><div class="result-label">Bolus</div><div class="result-val" id="tit-bolus-val">—</div><div class="result-sub">units IV now</div></div>
      <div class="result-item highlight"><div class="result-label">New Rate</div><div class="result-val" id="tit-new-rate">—</div><div class="result-sub">units/hr</div></div>
      <div class="result-item"><div class="result-label">Pump Rate</div><div class="result-val" id="tit-ml-rate">—</div><div class="result-sub">mL/hr</div></div>
      <div class="result-item full"><div class="result-label">Next aPTT Check</div><div id="tit-next-check" style="font-family:ui-monospace,Menlo,monospace; font-size:14px; color:var(--green); font-weight:700;">—</div></div>
    </div>
  </div>
</div>

<!-- TAB 3 -->
<div id="tab-nomogram" class="content">
  <div class="section-title">DVT/PE Protocol، Target aPTT: 60 to 100s</div>
  <div class="card" style="padding:0; overflow:hidden;">
    <table class="ref-table"><thead><tr><th>aPTT (sec)</th><th>Bolus</th><th>Rate Change</th><th>Hold</th><th>Next Check</th></tr></thead><tbody>
      <tr><td style="color:var(--red)"><strong>اقل من 40</strong></td><td><span class="badge badge-up">80 u/kg</span><br><small style="color:var(--muted)">max 5000u</small></td><td style="color:var(--orange)">+3 u/kg/h</td><td>لا</td><td>6h</td></tr>
      <tr><td style="color:var(--orange)"><strong>40 إلى 49</strong></td><td><span class="badge badge-up">40 u/kg</span><br><small style="color:var(--muted)">max 3000u</small></td><td style="color:var(--orange)">+2 u/kg/h</td><td>لا</td><td>6h</td></tr>
      <tr><td style="color:var(--orange)"><strong>50 إلى 59</strong></td><td>لا</td><td style="color:var(--orange)">+1 u/kg/h</td><td>لا</td><td>6h</td></tr>
      <tr class="therapeutic"><td style="color:var(--green)"><strong>60 إلى 100</strong></td><td>لا</td><td style="color:var(--green)">لا تغيير</td><td>لا</td><td>6h ثم 12h</td></tr>
      <tr><td style="color:var(--yellow)"><strong>101 إلى 120</strong></td><td>لا</td><td style="color:var(--yellow)">ناقص 1 u/kg/h</td><td>لا</td><td>6h</td></tr>
      <tr><td style="color:var(--orange)"><strong>121 إلى 150</strong></td><td>لا</td><td style="color:var(--orange)">ناقص 2 u/kg/h</td><td>وقف 30 دق</td><td>6h</td></tr>
      <tr><td style="color:var(--red)"><strong>اكثر من 150</strong></td><td>لا</td><td style="color:var(--red)">ناقص 3 u/kg/h</td><td>وقف 60 دق</td><td>6h</td></tr>
    </tbody></table>
    <div class="scroll-hint">بعد نتيجتين متتاليتين Therapeutic، فحص كل 12 ساعة</div>
  </div>
  <div class="section-title" style="margin-top:20px">ACS/NSTEMI Protocol، Target aPTT: 50 to 70s</div>
  <div class="card" style="padding:0; overflow:hidden;">
    <table class="ref-table"><thead><tr><th>aPTT (sec)</th><th>Bolus</th><th>Rate Change</th><th>Hold</th><th>Next</th></tr></thead><tbody>
      <tr><td style="color:var(--red)"><strong>اقل من 40</strong></td><td><span class="badge badge-up">60 u/kg</span><br><small>max 4000u</small></td><td style="color:var(--orange)">+2 u/kg/h</td><td>لا</td><td>6h</td></tr>
      <tr><td style="color:var(--orange)"><strong>40 إلى 49</strong></td><td>لا</td><td style="color:var(--orange)">+1 u/kg/h</td><td>لا</td><td>6h</td></tr>
      <tr class="therapeutic"><td style="color:var(--green)"><strong>50 إلى 70</strong></td><td>لا</td><td style="color:var(--green)">لا تغيير</td><td>لا</td><td>12h</td></tr>
      <tr><td style="color:var(--yellow)"><strong>71 إلى 90</strong></td><td>لا</td><td style="color:var(--yellow)">ناقص 1 u/kg/h</td><td>لا</td><td>6h</td></tr>
      <tr><td style="color:var(--orange)"><strong>91 إلى 120</strong></td><td>لا</td><td style="color:var(--orange)">ناقص 2 u/kg/h</td><td>وقف 30 دق</td><td>6h</td></tr>
      <tr><td style="color:var(--red)"><strong>اكثر من 120</strong></td><td>لا</td><td style="color:var(--red)">ناقص 3 u/kg/h</td><td>وقف 60 دق</td><td>6h</td></tr>
